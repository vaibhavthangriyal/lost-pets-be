PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/lost-pets
JWT_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-another-long-random-secret
OTP_DELIVERY=console
# Configure any SMTP provider (Brevo SMTP, Gmail SMTP relay, Mailgun, SendGrid, etc.) to enable email OTP delivery.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=verified@example.com
# Configure Twilio to enable SMS OTP delivery. Use E.164 phone numbers and a Twilio-enabled sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: Twilio Content Template SID for OTP messages (e.g. a verified free OTP template). Falls back to plain body when unset.
TWILIO_OTP_CONTENT_SID=
CORS_ORIGINS=http://localhost:5173
GCS_BUCKET=your-private-bucket-name
# Optional if the project can be detected from Application Default Credentials
GCS_PROJECT_ID=your-google-cloud-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
